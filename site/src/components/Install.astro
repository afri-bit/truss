---
import { url, REPO } from '../lib/url';

// The logo's truss, member by member; the circles are its joints.
const joints = [
  [3, 25],
  [29, 25],
  [9.5, 9],
  [22.5, 9],
  [16, 25],
];
---

<section class="sec install" id="install" aria-labelledby="install-h">
  <div class="wrap install__in">
    <div class="install__text">
      <h2 id="install-h">Install TRUSS</h2>
      <p class="lead">
        One binary. It needs Go 1.27.3 or newer to install; prebuilt binaries arrive with the first release.
      </p>
      <div class="codebar" data-copy-root>
        <code data-copy-text>go install github.com/afri-bit/truss/cmd/truss@latest</code>
        <button class="copy" type="button" data-copy aria-label="Copy the install command">
          <svg class="copy__a" viewBox="0 0 16 16" aria-hidden="true">
            <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" /><path d="M10.5 5.5v-2a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 3.5V9A1.5 1.5 0 0 0 4 10.5h1.5" />
          </svg>
          <svg class="copy__b" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" /></svg>
        </button>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary" href={url('docs/getting-started/')}>Get TRUSS</a>
        <a class="btn btn--secondary" href={REPO}>See the source on GitHub</a>
      </div>
    </div>
    <svg class="truss-art" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M3 25h26M3 25 9.5 9h13L29 25M9.5 9 16 25l6.5-16" />
      {joints.map(([x, y]) => <circle cx={x} cy={y} r="1.1" />)}
    </svg>
  </div>
</section>
