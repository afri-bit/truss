<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Managed by truss daemon install. Remove it with "truss daemon uninstall". -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.afri-bit.truss</string>
	<key>ProgramArguments</key>
	<array>
		<string>/home/me/my tools/truss</string>
		<string>daemon</string>
		<string>run</string>
		<string>--address</string>
		<string>127.0.0.1:9000</string>
		<string>--max-runs</string>
		<string>2</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>/home/me/truss $HOME %h/daemon.log</string>
	<key>StandardErrorPath</key>
	<string>/home/me/truss $HOME %h/daemon.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>TRUSS_HOME</key>
		<string>/home/me/truss $HOME %h</string>
	</dict>
</dict>
</plist>
