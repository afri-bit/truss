<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Managed by truss daemon install. Remove it with "truss daemon uninstall". -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.afri-bit.truss</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/truss</string>
		<string>daemon</string>
		<string>run</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>ExitTimeOut</key>
	<integer>75</integer>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>/home/me/.truss/daemon.log</string>
	<key>StandardErrorPath</key>
	<string>/home/me/.truss/daemon.log</string>
</dict>
</plist>
