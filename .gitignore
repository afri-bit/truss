# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

.DS_Store
Thumbs.db

# Editor/IDE
# .idea/
# .vscode/

bin/
.truss/

# Claude Code local settings and worktrees
.claude/settings.local.json
.claude/worktrees/

# Python bytecode from the agent tooling scripts
__pycache__/
*.pyc

node_modules/


# # Graphify

# # Bestimmte Graphify-Berichte erlauben und teilen
# !graphify-out/graph_labels.json
# !graphify-out/GRAPH_REPORT.md
# !graphify-out/graph.json
# !graphify-out/manifest.json

# # Große und lokale Cache-Dateien von Graphify ignorieren
# graphify-out/cache/
# graphify-out/graph.html
# graphify-out/graphify.db
# graphify-out/graphify-cache/
# graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

graphify-out/
