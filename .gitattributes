# Normalize all text to LF in the repository and in working trees, on every
# platform. TRUSS treats line endings as data (pipeline YAML, golden files),
# so checkouts must be byte-identical on Linux, macOS, and Windows.
* text=auto eol=lf

# Windows-native scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Go and module files
*.go   text eol=lf diff=golang
go.mod text eol=lf
go.sum text eol=lf linguist-generated=true

# Test fixtures that deliberately contain CRLF must opt out explicitly, e.g.
#   testdata/crlf/** -text

# Binary assets
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.db   binary
*.sqlite binary
